[Unit]
Description=AVF private SSH endpoint
Requires=termux-vm-bootstrap.service
After=termux-vm-bootstrap.service

[Service]
Type=exec
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/termux-vm-systemd sshd
ExecStartPost=/usr/local/sbin/termux-vm-systemd check-sshd
Restart=on-failure
RestartSec=1
KillMode=control-group
