[Unit]
Description=Host-only AVF vsock to SSH relay
ConditionKernelCommandLine=!termux_ci=1
Requires=termux-vm-sshd.service
After=termux-vm-sshd.service

[Service]
Type=exec
ExecStart=/usr/local/sbin/termux-vsock-ssh
ExecStartPost=/usr/local/sbin/termux-vm-systemd check-vsock
Restart=on-failure
RestartSec=1
KillMode=control-group
